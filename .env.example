# Local development defaults to deterministic demo mode. Never paste real
# secrets into this file.
LIGNEE_MODE=demo
LIGNEE_CATALOG_SOURCE=static
COMMERCE_CAPABLE=false

# Production bindings are launch-gated and intentionally blank.
LIGNEE_DATABASE_URL=
LIGNEE_DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_CATALOG_SOURCE_BUCKET=lignee-product-source
SUPABASE_CATALOG_MEDIA_BUCKET=lignee-public-derivatives
SUPABASE_SUPPORT_ATTACHMENTS_BUCKET=lignee-support-attachments
ORDER_ACCESS_TOKEN_SECRET=
ORDER_ACCESS_LOOKUP_SECRET=
ORDER_PII_ENCRYPTION_KEY_V1=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=
TCAT_CUSTOMER_ID=
TCAT_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
LIGNEE_COMPANY_NAME=
LIGNEE_UNIFIED_BUSINESS_NUMBER=
LIGNEE_SUPPORT_EMAIL=
LIGNEE_SUPPORT_PHONE=
LIGNEE_RETURN_ADDRESS=
# Immutable deployment attestations. Populate catalog/legal revisions before a
# production canary; add the evidence digest only after the canary is verified.
LIGNEE_CATALOG_APPROVAL_REVISION=
LIGNEE_LEGAL_APPROVAL_REVISION=
LIGNEE_CANARY_EVIDENCE_SHA256=
INCIDENT_WEBHOOK_URL=
DEADMAN_HEARTBEAT_URL_RESERVATION=
DEADMAN_HEARTBEAT_URL_REFUND_PRIORITY=
DEADMAN_HEARTBEAT_URL_RECONCILIATION=
